<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>


    <!-- Spring Boot parent configuration -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>


    <!-- Project group ID -->
    <groupId>com.madhav</groupId>

    <!-- Project/artifact name -->
    <artifactId>user-auth</artifactId>

    <!-- Project version -->
    <version>0.0.1-SNAPSHOT</version>

    <!-- Project name -->
    <name/>

    <!-- Project description -->
    <description/>

    <!-- Project website URL -->
    <url/>


    <!-- Project license information -->
    <licenses>
        <license/>
    </licenses>


    <!-- Project developer information -->
    <developers>
        <developer/>
    </developers>


    <!-- Source Code Management information -->
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>


    <!-- Project properties -->
    <properties>

        <!-- Java version used by the project -->
        <java.version>21</java.version>

    </properties>


    <!-- ====================================================== -->
    <!-- PROJECT DEPENDENCIES                                  -->
    <!-- ====================================================== -->

    <dependencies>


        <!-- Spring Data JPA dependency -->
        <!-- Database ke saath JPA/Hibernate ke through kaam karne ke liye -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>


        <!-- Spring Security dependency -->
        <!-- Authentication aur Authorization ke liye -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>


        <!-- Spring Validation dependency -->
        <!-- @NotNull, @Email, @Size jaise validation annotations ke liye -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>


        <!-- Spring WebMVC dependency -->
        <!-- REST API aur Controller banane ke liye -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>


        <!-- MySQL database dependency -->
        <!-- Spring Boot ko MySQL database se connect karne ke liye -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>


        <!-- Lombok dependency -->
        <!-- Getters, Setters, Constructors jaise boilerplate code automatically generate karne ke liye -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>


        <!-- Spring Data JPA testing dependency -->
        <!-- JPA aur database related testing ke liye -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- Spring Security testing dependency -->
        <!-- Security related testing ke liye -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- Spring Validation testing dependency -->
        <!-- Validation related testing ke liye -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- Spring WebMVC testing dependency -->
        <!-- Controller aur REST API testing ke liye -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- JWT API dependency -->
        <!-- JWT create, parse aur handle karne ke liye main JWT API -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>


        <!-- JWT implementation dependency -->
        <!-- JWT API ka actual implementation provide karta hai -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>


        <!-- JWT Jackson dependency -->
        <!-- JWT ke JSON data ko Jackson ke through process karne ke liye -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>


    </dependencies>


    <!-- ====================================================== -->
    <!-- MAVEN BUILD CONFIGURATION                             -->
    <!-- ====================================================== -->

    <build>

        <plugins>


            <!-- Spring Boot Maven Plugin -->
            <!-- Spring Boot application ko Maven ke through run/package karne ke liye -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>


            <!-- Maven Compiler Plugin -->
            <!-- Java source code ko compile karne ke liye -->
            <plugin>

                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>


                <executions>


                    <!-- Main Java code compilation -->
                    <execution>

                        <id>default-compile</id>
                        <phase>compile</phase>

                        <goals>
                            <goal>compile</goal>
                        </goals>


                        <configuration>

                            <!-- Lombok annotation processor -->
                            <annotationProcessorPaths>

                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>

                            </annotationProcessorPaths>

                        </configuration>

                    </execution>


                    <!-- Test Java code compilation -->
                    <execution>

                        <id>default-testCompile</id>
                        <phase>test-compile</phase>

                        <goals>
                            <goal>testCompile</goal>
                        </goals>


                        <configuration>

                            <!-- Lombok annotation processor for test code -->
                            <annotationProcessorPaths>

                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>

                            </annotationProcessorPaths>

                        </configuration>

                    </execution>


                </executions>

            </plugin>


        </plugins>

    </build>


</project>